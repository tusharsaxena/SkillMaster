## Interface: 16001
## AllowLoadGameType: camelot
## ExcludeLoadGameType: standard
## Title: Ka0s Skill Master
## Notes: Weapon skills, professions and character stats as customizable bars, for WoW Forever.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\SkillMaster\media\logos\skillmaster.logo.128.tga
## SavedVariables: SkillMasterDB, SkillMasterPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, EllesmereUI
## DefaultState: enabled
## Category-enUS: UI
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
# LOAD-BEARING: after AceGUI. AceConfigDialog resolves AceGUI-3.0 at file load (settings\Profiles.lua).
libs\AceConfig-3.0\AceConfig-3.0.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
# The launcher's two libraries (launcher-§1); conventional, resolved at Register time.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml

# Locales
# LOAD-BEARING: creates NS.L, which core\DebugLogSetup.lua and every settings\ file read at FILE SCOPE.
locales\enUS.lua
# LOAD-BEARING: each translation fills NS.L (created by locales\enUS.lua) at FILE SCOPE, after every
# enUS file; each is gated on its own GetLocale() (localization-§1) and is a stub until filled.
locales\deDE.lua
locales\esES.lua
locales\esMX.lua
locales\frFR.lua
locales\itIT.lua
locales\koKR.lua
locales\ptBR.lua
locales\ruRU.lua
locales\zhCN.lua
locales\zhTW.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: NS.name, NS.version, NS.PREFIX and NS.LIBKA0S_MISSING, read by every file below.
core\Namespace.lua
# Conventional: NS.Compat, the compat family's root; its shims are reached at CALL time.
core\Compat.lua
# LOAD-BEARING: wraps every NS.Compat member at load (LibKa0s-Sim-1.0's seam). It must load straight
# after the Compat files and before any file that reads a Compat member.
core\SimSetup.lua
# LOAD-BEARING: NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at FILE SCOPE.
core\MediaSetup.lua
# LOAD-BEARING: NS.Constants (the brand, the logos, LAYERS), read at FILE SCOPE by the setup files below.
core\Constants.lua
core\State.lua
core\EnvSetup.lua
# LOAD-BEARING: NS.Print / NS.Util.print and the SafeRegister family; before everything that prints.
core\CoreSetup.lua
# LOAD-BEARING: RegisterOwner at FILE SCOPE; NS.DEFAULT_SKIN is read by defaults\Profile.lua and the
# skin option lists by settings\General.lua, both at FILE SCOPE.
core\SkinSetup.lua
# LOAD-BEARING: NS.MSG and NS.bus; the catalog must exist before any module subscribes at load.
core\Bus.lua
core\PoolSetup.lua
# LOAD-BEARING: NS.Widgets, captured at FILE SCOPE by modules\MainWindow.lua's chrome build path.
core\WidgetsSetup.lua
# LOAD-BEARING: NS.Lifecycle, which core\PerfSetup.lua hands LibKa0s-Perf-1.0 at FILE SCOPE.
core\LifecycleSetup.lua
# LOAD-BEARING: NS.Perf, a FILE-SCOPE upvalue in modules\MainWindow.lua.
core\PerfSetup.lua
# LOAD-BEARING: after Constants (FONT_MONO), State (the flag) and CoreSetup (the printer); before any NS.Debug call.
core\DebugLogSetup.lua
# LOAD-BEARING: NewAddon(NS, ...) and the NS.Print reclaim at FILE SCOPE, so it follows core\CoreSetup.lua.
core\SkillMaster.lua
core\Database.lua
# Conventional: builds the launcher object at load; Register() runs from OnEnable.
core\LauncherSetup.lua

# Defaults (the only place a default is written -- savedvariables-§2)
defaults\Profile.lua
# LOAD-BEARING: NS.SkillCatalog and NS.ClassWeapons_Forever, read at FILE SCOPE by modules\SkillData.lua.
defaults\SkillCatalog_Forever.lua
defaults\ClassWeapons_Forever.lua
# T2.4: the trainer, rank, gathering and fishing tables; read by modules\Trainers.lua and
# modules\Helpers.lua at CALL time, and through NS.L at FILE SCOPE (after locales\enUS.lua).
defaults\Ranks_Forever.lua
defaults\Trainers_Forever.lua
defaults\Gathering_Forever.lua
defaults\Fishing_Forever.lua
# T2.2: NS.Racials_Forever, read by modules\Bonuses.lua at call time.
defaults\Racials_Forever.lua
# Conventional: NS.STAT_DEFS, read by modules\StatData.lua at CALL time.
defaults\Stats_Forever.lua
# Conventional: NS.Preview_Forever, test mode's sample character, read by modules\Preview.lua and
# modules\Simulator.lua at CALL time.
defaults\Preview_Forever.lua

# Modules -- each reaches the others at CALL time
# Conventional: NS.Bar, the data bar (T3.1); reads NS.Skin, NS.Pool and the profile at CALL time.
modules\Bar.lua
# Conventional: NS.Chrome, the shared icon controls (T3.2); reads NS.Icon and NS.Skin at CALL time.
modules\Chrome.lua
# Conventional: NS.Rows, one skill or stat row (T3.2); reaches Bar, Trainers and Bonuses at CALL time.
modules\Rows.lua
# Conventional: NS.Blocks (T3.2); declares NS.BLOCKS and NS.BlockDefs through NS.L at FILE SCOPE and
# subscribes on its own bus target (after core\Bus.lua).
modules\Blocks.lua
# Conventional: NS.Detached, a detached block's frame (T3.2); reads NS.Blocks at CALL time.
modules\Detached.lua
# T3.3, each conventional (reached at CALL time): the combat queue and the crafting rows' secure
# overlays (registers its two combat events on its own bus target at FILE SCOPE, after core\Bus.lua),
# the click map, the row tooltip, the trainer popup and the waypoint providers.
modules\SecureOverlay.lua
modules\Interact.lua
modules\RowTooltip.lua
modules\TrainerPopup.lua
modules\Waypoints.lua
# Publishes NS.BINDINGS, read by settings\General.lua at FILE SCOPE; the # Modules -> # Settings order guarantees it.
modules\MainWindow.lua
# Conventional: `/skm probe`; reads core\ members only at FILE SCOPE (NS.Widgets, NS.Constants).
modules\Probe.lua
# Conventional: builds NS.SkillNameToKey from the catalog and NS.L at FILE SCOPE (both load earlier).
modules\SkillData.lua
# Conventional: pure lookups over the defaults\*_Forever.lua tables, read at CALL time (T2.4).
modules\Trainers.lua
# Conventional: publishes NS.SkillHelpers (NS.Helpers is the options library, settings\OptionsSetup.lua).
modules\Helpers.lua
# T2.2: defines NS.addon:OnBonusesUnitChanged at FILE SCOPE, so it follows core\SkillMaster.lua; reads NS.SkillData at call time.
modules\Bonuses.lua
# Conventional: the DebugLog descriptor asks for its sections at RUN time.
modules\Diagnostics.lua
# Conventional: registers its events on a tracked bus target at FILE SCOPE (after core\Bus.lua).
modules\StatData.lua
# T4.3: subscribe on tracked bus targets at FILE SCOPE (after core\Bus.lua); read NS.SkillData at call time.
modules\SessionLog.lua
modules\Alts.lua
# T4.3: the Journal window; reads NS.SessionLog and NS.Alts at call time.
modules\Journal.lua
# T4.2: subscribes to SKILL_UP / SKILLS_UPDATED on its own bus target at FILE SCOPE (after core\Bus.lua);
# reads NS.SkillData, NS.Trainers and the settings at CALL time.
modules\Alerts.lua
# T4.1: NS.Template, pure; read by modules\Broker.lua at CALL time.
modules\Template.lua
# T4.1: the four broker data feeds; creates its LibDataBroker objects and bus target at FILE SCOPE
# (after core\Bus.lua, core\PoolSetup.lua and the # Libraries block); reads NS.StatData.GROUPS at call time.
modules\Broker.lua
# T5.2: test mode's data swap; builds its models through SkillData, StatData and Bonuses at CALL time.
modules\Preview.lua
# T5.2: the simulator. LOAD-BEARING: after every module whose handler it delivers to and after
# core\SimSetup.lua (the seam it binds); Sim:New and the providers run at FILE SCOPE.
modules\Simulator.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: NS.Schema, NS.SetByPath and NS.SchemaRuntime, read at FILE SCOPE by the three files below.
settings\Schema.lua
# LOAD-BEARING: NS.Slash, read by settings\General.lua's landing spec; NS.COMMANDS by the launcher at call time.
settings\Slash.lua
# LOAD-BEARING: NS.Helpers and NS.RegisterOptionsPage, called at FILE SCOPE by every page below.
settings\OptionsSetup.lua
# LOAD-BEARING: General registers FIRST and Profiles LAST; page order IS registration order.
settings\General.lua
# T5.1 the display pages, in the sidebar's order (Skills.lua registers Skills, then Stats). Each reads
# NS.Blocks, NS.SkillCatalog, NS.STAT_DEFS and NS.Template at FILE SCOPE, all loaded above.
settings\Layout.lua
settings\Bars.lua
settings\Skills.lua
settings\Broker.lua
settings\Alerts.lua
settings\Journal.lua
settings\Trainers.lua
settings\Profiles.lua
