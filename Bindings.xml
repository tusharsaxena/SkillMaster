<Bindings>
	<!-- Show window (launcher-§6), first: clicks the plain, hidden CharacterLedgerToggleWindow button that modules/MainWindow.lua creates at load, whose click toggles the Professions window, the handler the launcher's Show window entry and /cl professions run (/cl toggle shows or hides every window, R5-SM-05). -->
	<Binding name="CLICK CharacterLedgerToggleWindow:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<!-- The other five family windows (SMW-04), in the family order (defaults/Families.lua): each clicks a plain, hidden button created beside it, whose click toggles that window, the handler its /cl verb and its launcher entry run. The names are permanent once shipped. -->
	<Binding name="CLICK CharacterLedgerToggleSkills:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<Binding name="CLICK CharacterLedgerToggleStats:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<Binding name="CLICK CharacterLedgerToggleCurrencies:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<Binding name="CLICK CharacterLedgerToggleReputations:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<Binding name="CLICK CharacterLedgerToggleStatistics:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
	<!-- The Journal: clicks the plain, hidden CharacterLedgerToggleJournal button, created beside them, whose click runs NS.Journal.Toggle, the handler /cl journal and the title-bar mark run. Every label and NS.BINDINGS are set in modules/MainWindow.lua. No default key: the player picks one under Options, Keybindings, Ka0s Character Ledger, or on the General page's Keybindings tab. -->
	<Binding name="CLICK CharacterLedgerToggleJournal:LeftButton" category="BINDING_HEADER_CHARACTERLEDGER"/>
</Bindings>
