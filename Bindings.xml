<Bindings>
	<!-- Show window (launcher-§6), first: clicks the plain, hidden SkillMasterToggleWindow button that modules/MainWindow.lua creates at load, whose click runs NS.MainWindow.Toggle, the handler the launcher's Show window entry and /sm toggle run. -->
	<Binding name="CLICK SkillMasterToggleWindow:LeftButton" category="BINDING_HEADER_SKILLMASTER"/>
	<!-- The Journal: clicks the plain, hidden SkillMasterToggleJournal button, created beside it, whose click runs NS.Journal.Toggle, the handler /sm journal and the title-bar mark run. Both labels and NS.BINDINGS are set in modules/MainWindow.lua. No default key: the player picks one under Options, Keybindings, Ka0s Skill Master, or on the General page's Keybindings tab. -->
	<Binding name="CLICK SkillMasterToggleJournal:LeftButton" category="BINDING_HEADER_SKILLMASTER"/>
</Bindings>
